#cloud-config
# 共用主機第一次開機（infra/host.tf）。只做兩件事：掛 /srv 資料碟、裝套件。
# 其餘的設定由 SSM 的 PlatformSync 套用（infra/ssm.tf），它會等這份跑完才開始。

write_files:
  # write_files 在裝套件之前執行：之後在這台主機上 apt 裝任何東西都不帶推薦套件
  - path: /etc/apt/apt.conf.d/90platform-no-recommends
    content: |
      APT::Install-Recommends "false";
      APT::Install-Suggests "false";
  - path: /etc/platform/data-volume-id
    content: "${data_volume_id}\n"
  - path: /usr/local/sbin/mount-data
    permissions: "0755"
    content: ${jsonencode(mount_script)}

package_update: true
# infra/host/packages.txt（主機模擬器讀同一份）
packages: ${jsonencode(packages)}

snap:
  commands:
    - snap install aws-cli --classic

runcmd:
  - /usr/local/sbin/mount-data

#!/bin/bash
# 寄信（SES）的臨時憑證（docs/host-platform.md「寄信（SES）」）：platform.env 的 SES_PROJECTS 每個專案 assume 一次
# platform-ses-<專案>（infra/ses.tf，1 小時效期），寫成 /srv/<專案>/aws/credentials.json（AWS 的 credential_process 格式）。
# tenant-credentials.timer 每 15 分鐘跑一次；install.sh 與 tenant-deploy 也先跑一次（容器起來之前檔案就要在）。
#
#   tenant-credentials            所有開了 ses 的專案
#   tenant-credentials <專案>      只更新這一個（tenant-deploy 用）
#
# 單一專案失敗不影響別的專案；舊的憑證還有效就照用（到期前有 45 分鐘可以重試）。
# 已經沒有開 ses 的專案，留下的憑證檔刪掉。
set -uo pipefail
export HOME=/root PATH="$PATH:/snap/bin"
# shellcheck source=/dev/null
. /usr/local/lib/platform/platform.env
export AWS_REGION="$REGION" AWS_DEFAULT_REGION="$REGION"

only="${1:-}"
rc=0
for p in ${SES_PROJECTS:-}; do
  [[ -z "$only" || "$p" == "$only" ]] || continue
  dir="/srv/$p/aws"
  install -d -m 755 "$dir"
  tmp="$(mktemp "$dir/.credentials.XXXXXX")"
  if aws sts assume-role --role-arn "arn:aws:iam::$ACCOUNT_ID:role/platform-ses-$p" --role-session-name "host-$p" \
    --duration-seconds 3600 --output json | python3 -c '
import datetime, json, sys
c = json.load(sys.stdin)["Credentials"]
exp = datetime.datetime.fromisoformat(c["Expiration"].replace("Z", "+00:00")).astimezone(datetime.timezone.utc)
json.dump({"Version": 1, "AccessKeyId": c["AccessKeyId"], "SecretAccessKey": c["SecretAccessKey"],
           "SessionToken": c["SessionToken"], "Expiration": exp.strftime("%Y-%m-%dT%H:%M:%SZ")}, sys.stdout)
' >"$tmp"; then
    # 容器裡不一定是 root（例如 65532）：檔案給所有人讀。主機上只有 root，別的專案的容器看不到 /srv/<專案>/
    chmod 444 "$tmp"
    mv -f "$tmp" "$dir/credentials.json"
    echo "tenant-credentials: $p 更新"
  else
    rm -f "$tmp"
    echo "tenant-credentials: $p 失敗（舊的憑證到期前會再試）" >&2
    rc=1
  fi
done

# 已經沒有開 ses 的專案：刪掉留下的憑證
if [[ -z "$only" ]]; then
  for f in /srv/*/aws/credentials.json; do
    [[ -f "$f" ]] || continue
    p="$(basename "$(dirname "$(dirname "$f")")")"
    if [[ " ${SES_PROJECTS:-} " != *" $p "* ]]; then
      rm -f "$f"
      echo "tenant-credentials: $p 沒有開 ses，刪掉憑證"
    fi
  done
fi
exit "$rc"

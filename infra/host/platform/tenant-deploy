#!/bin/bash
# 部署一個專案（docs/host-platform.md「專案的約定」）。由 SSM 文件 TenantDeploy 以 root 執行。
#
#   tenant-deploy <專案>           從 s3://<部署 bucket>/<專案>/bundle.tar.gz 拿部署包
#   tenant-deploy --local <專案>   用 /srv/<專案>/ 現有的內容（換主機之後由 install.sh 呼叫）
#
# 部署包：quadlet/（單元檔與這個環境的 drop-in）、site.caddy（填好網域的站台檔，選配）、backup.sh（選配）、
# hourly.sh（選配，每小時執行一次，tenant-hourly）。
set -euo pipefail
export HOME=/root PATH="$PATH:/snap/bin" REGISTRY_AUTH_FILE=/etc/containers/platform-auth.json
# shellcheck source=/dev/null
. /usr/local/lib/platform/platform.env

log() { echo "tenant-deploy: $*"; }
die() {
  echo "tenant-deploy: $*" >&2
  exit 1
}

local_only=false
if [[ "${1:-}" == --local ]]; then
  local_only=true
  shift
fi
p="${1:-}"
[[ "$p" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "用法：tenant-deploy [--local] <專案>"
[[ "$p" != edge && "$p" != containers ]] || die "$p 是平台保留的名稱"

src="/srv/$p"
dst="/etc/containers/systemd/$p"
site="/srv/edge/caddy/sites/$p.caddy"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# 先在暫存區把整包驗證完（結構、檔名、站台檔），才寫進 /srv/<專案>/ 與重啟服務：壞的部署包整包不生效，
# /srv 裡的正本永遠是驗證過的那一份（換主機時 --local 會照它裝回來）。

# 用候選的站台檔驗證整份 Caddy 設定，驗完馬上放回原本的：一個專案的站台檔不能弄壞所有專案
check_site() { # check_site <候選的站台檔，或空字串表示不要站台>
  local had=false ok=true
  if [[ -f "$site" ]]; then
    cp "$site" "$tmp/site.prev"
    had=true
  fi
  if [[ -n "$1" ]]; then install -m 644 "$1" "$site"; else rm -f "$site"; fi
  podman exec edge-caddy caddy validate --config /etc/caddy/Caddyfile >"$tmp/validate.log" 2>&1 || ok=false
  if $had; then install -m 644 "$tmp/site.prev" "$site"; else rm -f "$site"; fi
  $ok || cat "$tmp/validate.log" >&2
  $ok
}

# ---------- 1. 部署包：解開、驗證、寫進 /srv/<專案>/ ----------
if $local_only; then
  stage="$src"
else
  aws s3 cp --only-show-errors "s3://$DEPLOY_BUCKET/$p/bundle.tar.gz" "$tmp/bundle.tar.gz"
  stage="$tmp/b"
  mkdir "$stage"
  tar -xzf "$tmp/bundle.tar.gz" -C "$stage" --no-same-owner --no-same-permissions
fi
if [[ ! -d "$stage/quadlet" ]]; then
  if $local_only; then die "$src/quadlet 不存在（$p 還沒部署過）"; else die "部署包裡沒有 quadlet/"; fi
fi
[[ -z "$(find "$stage" -type l -print -quit)" ]] || die "部署包裡不能有符號連結"
# 所有單元與 drop-in 資料夾都以專案名稱開頭：共用主機上不會撞名，也放不進影響別人的頂層 drop-in
for f in "$stage"/quadlet/*; do
  b="$(basename "$f")"
  [[ "$b" == "$p".* || "$b" == "$p"-* ]] || die "quadlet/$b：檔名要以 $p 開頭"
done
new_site=""
[[ -f "$stage/site.caddy" ]] && new_site="$stage/site.caddy"
check_site "$new_site" || die "site.caddy 驗證失敗，這次部署不生效（服務與站台都沒有動）"

if ! $local_only; then
  install -d -m 755 "$src"
  rm -rf "$src/quadlet.new" "$src/quadlet.prev"
  cp -r "$stage/quadlet" "$src/quadlet.new"
  # 上一包的單元檔留一份：範本單元的新版起不來時換回來（第 4 步）
  [[ -d "$src/quadlet" ]] && mv "$src/quadlet" "$src/quadlet.prev"
  mv "$src/quadlet.new" "$src/quadlet"
  for f in site.caddy backup.sh hourly.sh; do
    if [[ -f "$stage/$f" ]]; then
      mode=644
      [[ "$f" == *.sh ]] && mode=755
      install -m "$mode" "$stage/$f" "$src/$f"
    else
      rm -f "$src/$f"
    fi
  done
fi

# ---------- 2. 秘密：Parameter Store /<專案>/<名稱> → podman secret <專案>_<名稱>（值走 stdin，不進命令列）----------
aws ssm get-parameters-by-path --path "/$p/" --with-decryption --output json | python3 -c '
import hashlib, json, re, subprocess, sys
project, digest_file = sys.argv[1], sys.argv[2]
count = 0
digest = hashlib.sha256()
params = sorted(json.load(sys.stdin)["Parameters"], key=lambda x: x["Name"])
for param in params:
    full = param["Name"]
    name = full.rsplit("/", 1)[1]
    if not re.fullmatch(r"[A-Za-z0-9_]+", name):
        sys.exit(f"tenant-deploy: 參數名稱只能有英數字與底線：{full}")
    subprocess.run(
        ["podman", "secret", "create", "--replace", f"{project}_{name}", "-"],
        input=param["Value"].encode(), check=True, stdout=subprocess.DEVNULL,
    )
    digest.update(full.encode() + b"\0" + hashlib.sha256(param["Value"].encode()).digest())
    count += 1
with open(digest_file, "w") as f:
    f.write(digest.hexdigest() + "\n")
print(f"tenant-deploy: 同步了 {count} 個秘密")
' "$p" "$src/.secrets.sha256.new"
secrets_changed=true
cmp -s "$src/.secrets.sha256.new" "$src/.secrets.sha256" 2>/dev/null && secrets_changed=false
mv "$src/.secrets.sha256.new" "$src/.secrets.sha256"

# ---------- 3. 映像先拉好，重啟時不會卡在下載（已經有的不重拉：部署用的標籤不可覆寫）----------
mapfile -t images < <(grep -rhoP '^\s*Image=\K\S+' "$src/quadlet" | grep -vE '\.(image|build)$' | sort -u)
for img in "${images[@]}"; do
  podman image exists "$img" && continue
  log "拉 $img"
  podman pull -q "$img" >/dev/null
done

# ---------- 4. 安裝單元、只重啟需要的服務 ----------
# 一般單元（<名稱>.container）：只有它自己的檔案或 drop-in 變了、秘密變了、或沒在跑才重啟（只換站台檔、backup.sh、
# hourly.sh 時線上的人不會斷線；只換了伺服器的映像時資料庫不會跟著重啟）。.network、.volume 這類變了就全部重啟。
#
# 範本單元（<名稱>@.container）：換版不斷線（docs/host-platform.md「範本單元」）。平台平常只跑一份（@a 或 @b，
# 記在 /srv/<專案>/.slot-<名稱>），要換的時候在另一個位子起新版、等它健康（Notify=healthy）才關舊的；
# 新版起不來就把它停掉，舊版照常服務。開機時只有現在的位子會起來（只有它有實例檔，[Install] 只套在它身上）。
# 一般單元（範本 <名稱>@.container 與平台建的實例檔 <名稱>@<位子>.container 都不算）
services_in() {
  local f
  for f in "$1"/*.container; do
    [[ -e "$f" ]] || continue
    f="$(basename "$f" .container)"
    [[ "$f" == *@* ]] || echo "$f.service"
  done
  return 0
}
templates_in() {
  local f
  for f in "$1"/*@.container; do
    [[ -e "$f" ]] && basename "$f" .container | sed 's/@$//'
  done
  return 0
}
# 一個單元檔（含它的 drop-in 資料夾）和現在裝著的不一樣
unit_changed() { # unit_changed <檔名>
  [[ -d "$dst" ]] || return 0
  diff -q "$src/quadlet/$1" "$dst/$1" >/dev/null 2>&1 || return 0
  [[ -d "$src/quadlet/$1.d" || -d "$dst/$1.d" ]] || return 1
  ! diff -rq "$src/quadlet/$1.d" "$dst/$1.d" >/dev/null 2>&1
}
slot_of() { cat "$src/.slot-$1" 2>/dev/null || true; }

mapfile -t new < <(services_in "$src/quadlet")
mapfile -t tpls < <(templates_in "$src/quadlet")
old=()
[[ -d "$dst" ]] && mapfile -t old < <(services_in "$dst")
# .network、.volume 這類：本來就有的變了或拿掉了才算（新加的只有用到它的單元會用，那些單元本來就會起或重啟）
others_changed=false
if [[ -d "$dst" ]]; then
  for f in "$dst"/*; do
    b="$(basename "$f")"
    [[ "$b" == *.container || "$b" == *.container.d ]] && continue
    if [[ -d "$f" ]]; then
      diff -rq "$f" "$src/quadlet/$b" >/dev/null 2>&1 || others_changed=true
    else
      diff -q "$f" "$src/quadlet/$b" >/dev/null 2>&1 || others_changed=true
    fi
  done
else
  others_changed=true
fi

restart=()
for u in "${new[@]}"; do
  if $secrets_changed || $others_changed || unit_changed "${u%.service}.container" || ! systemctl is-active --quiet "$u"; then
    restart+=("$u")
  fi
done

rm -rf "$dst.new"
cp -r "$src/quadlet" "$dst.new"
# 範本現在的位子保留實例檔（符號連結到範本）：開機照樣起來、daemon-reload 之後還是同一個單元
for t in "${tpls[@]}"; do
  cur="$(slot_of "$t")"
  [[ -n "$cur" ]] && ln -s "$t@.container" "$dst.new/$t@$cur.container"
done
tpl_changed=()
for t in "${tpls[@]}"; do
  if $secrets_changed || $others_changed || unit_changed "$t@.container"; then tpl_changed+=("$t"); fi
done
rm -rf "$dst"
mv "$dst.new" "$dst"
systemctl daemon-reload
if ((${#restart[@]})); then
  log "重啟 ${restart[*]}"
  systemctl restart "${restart[@]}"
elif ((${#new[@]})); then
  log "一般單元與秘密都沒變、服務都在跑：不重啟"
fi

# 範本：需要換（範本或它的 drop-in 變了、秘密變了、現在的位子沒在跑、還沒有位子）就換到另一個位子
for t in "${tpls[@]}"; do
  cur="$(slot_of "$t")"
  need=false
  printf '%s\n' "${tpl_changed[@]}" | grep -qxF "$t" && need=true
  [[ -z "$cur" ]] && need=true
  [[ -n "$cur" ]] && ! systemctl is-active --quiet "$t@$cur.service" && need=true
  if ! $need; then
    log "$t@$cur 沒變、在跑：不換"
    continue
  fi
  next=a
  [[ "$cur" == a ]] && next=b
  ln -sfn "$t@.container" "$dst/$t@$next.container"
  systemctl daemon-reload
  log "$t：起 @$next${cur:+（現在是 @$cur）}，等它健康"
  if ! systemctl start "$t@$next.service"; then
    journalctl -u "$t@$next.service" -n 40 --no-pager >&2 || true
    systemctl stop "$t@$next.service" || true
    # 單元檔換回上一包：正在服務的舊版之後自己重啟、或主機重開機，才不會用到起不來的設定
    if [[ -d "$src/quadlet.prev" ]]; then
      rm -rf "$src/quadlet" "$dst"
      cp -r "$src/quadlet.prev" "$src/quadlet"
      cp -r "$src/quadlet" "$dst"
      while read -r pt; do
        ps="$(slot_of "$pt")"
        [[ -n "$ps" ]] && ln -s "$pt@.container" "$dst/$pt@$ps.container"
      done < <(templates_in "$dst")
    else
      rm -f "$dst/$t@$next.container"
    fi
    systemctl daemon-reload
    die "$t@$next 起不來，已經停掉、單元檔換回上一包${cur:+；@$cur 照常服務}（站台檔沒有更新）"
  fi
  if [[ -n "$cur" ]]; then
    log "$t：@$next 健康了，關 @$cur（它先排水再停）"
    systemctl stop "$t@$cur.service" || true
    rm -f "$dst/$t@$cur.container"
  fi
  echo "$next" >"$src/.slot-$t"
  systemctl daemon-reload
done

# ---------- 5. 確認都起來了（起來之後馬上掛掉的也要抓到）----------
check=("${new[@]}")
for t in "${tpls[@]}"; do check+=("$t@$(slot_of "$t").service"); done
((${#restart[@]})) && sleep 5
failed=()
for u in "${check[@]}"; do
  systemctl is-active --quiet "$u" || failed+=("$u")
done
if ((${#failed[@]})); then
  for u in "${failed[@]}"; do journalctl -u "$u" -n 30 --no-pager >&2 || true; done
  die "沒有起來：${failed[*]}（站台檔沒有更新）"
fi

# ---------- 6. 站台（第 1 步驗證過了）----------
if [[ -f "$src/site.caddy" ]]; then
  install -m 644 "$src/site.caddy" "$site"
else
  rm -f "$site"
fi
podman exec edge-caddy caddy reload --config /etc/caddy/Caddyfile

# ---------- 7. 這次不再有的服務：新的起來、站台換好之後才停（換了單元名稱也不斷線）----------
for u in "${old[@]}"; do
  printf '%s\n' "${new[@]}" | grep -qxF "$u" && continue
  log "停掉不再有的 $u"
  systemctl stop "$u" || true
done
# 不再有的範本：還在跑的位子都停掉、忘掉它的位子
while read -r u _; do
  t="${u%@*}"
  printf '%s\n' "${tpls[@]}" | grep -qxF "$t" && continue
  log "停掉不再有的 $u"
  systemctl stop "$u" || true
  rm -f "$src/.slot-$t"
done < <(systemctl list-units --plain --no-legend --state=active "$p-*@*.service")

log "$p 部署完成"

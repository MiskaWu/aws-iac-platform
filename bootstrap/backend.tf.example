# 第一次 apply 完成後，把這個檔案改名成 backend.tf，
# bucket 換成 `tofu output -raw state_bucket` 的值，然後執行：
#   tofu init -migrate-state
# 本機的 terraform.tfstate 會被搬進 S3。

terraform {
  backend "s3" {
    bucket       = "tofu-state-123456789012-ap-east-2"
    key          = "bootstrap/terraform.tfstate"
    region       = "ap-east-2"
    use_lockfile = true
  }
}

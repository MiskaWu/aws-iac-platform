# 主機模擬器：和正式主機同一版 Ubuntu 與 podman，跑同一份平台腳本（infra/host/platform/）。
# aws 指令換成 fake-aws：S3 與 Parameter Store 是掛進來的資料夾。
FROM docker.io/library/ubuntu:26.04
# 平台的套件和 infra/host/cloud-init.yaml.tftpl 一致（podman aardvark-dns amazon-ecr-credential-helper），
# 而且不裝推薦套件：正式主機少了什麼，這裡會先壞掉。後面一排是模擬器自己要的。
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       podman aardvark-dns amazon-ecr-credential-helper \
       systemd systemd-sysv dbus python3 ca-certificates curl iproute2 iptables \
    && rm -rf /var/lib/apt/lists/*
# 只有模擬器：WSL 的核心沒有 nft_fib_inet，netavark 的 nftables 規則（fib daddr type local）套不上，改走 iptables。
# EC2 上 Ubuntu 的核心有這個模組，正式主機照預設用 nftables。
RUN mkdir -p /etc/containers/containers.conf.d \
    && printf '[network]\nfirewall_driver = "iptables"\n' > /etc/containers/containers.conf.d/50-host-sim.conf
COPY fake-aws /usr/local/bin/aws
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]

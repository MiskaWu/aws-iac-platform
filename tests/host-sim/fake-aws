#!/usr/bin/env python3
# 主機模擬器用的假 aws 指令：S3 是 /fake/s3/<bucket>/<key>，Parameter Store 是 /fake/ssm/<路徑>（檔案內容就是值）。
# 只做平台腳本用到的：s3 sync、s3 cp、ssm get-parameters-by-path。
import json
import os
import shutil
import sys

S3, SSM = "/fake/s3", "/fake/ssm"
FLAGS = {"--only-show-errors", "--with-decryption", "--delete"}
args = [a for a in sys.argv[1:] if a not in FLAGS]


def local(path):
    return os.path.join(S3, path[len("s3://"):]) if path.startswith("s3://") else path


if args[:2] == ["s3", "sync"]:
    src, dst = local(args[2]), args[3]
    if "--delete" in sys.argv and os.path.isdir(dst):
        shutil.rmtree(dst)
    shutil.copytree(src, dst, dirs_exist_ok=True)
elif args[:2] == ["s3", "cp"]:
    src, dst = local(args[2]), local(args[3])
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copyfile(src, dst)
elif args[:2] == ["ssm", "get-parameters-by-path"]:
    path = args[args.index("--path") + 1]
    folder = os.path.join(SSM, path.strip("/"))
    params = []
    if os.path.isdir(folder):
        for name in sorted(os.listdir(folder)):
            with open(os.path.join(folder, name)) as f:
                params.append({"Name": f"{path.rstrip('/')}/{name}", "Value": f.read().rstrip("\n")})
    print(json.dumps({"Parameters": params}))
else:
    sys.exit(f"fake-aws: 沒有實作 {' '.join(sys.argv[1:])}")
